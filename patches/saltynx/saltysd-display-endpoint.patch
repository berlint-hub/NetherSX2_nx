diff --git a/saltysd_proc/source/service.c b/saltysd_proc/source/service.c
index f95bea6..382fcc8 100644
--- a/saltysd_proc/source/service.c
+++ b/saltysd_proc/source/service.c
@@ -1269,3 +1269,62 @@ void serviceThread()
     
     SaltyNX_printf(APP_NAME ": done accepting service calls\n");
 }
+
+
+/* Isolated read-only client port for NetherSX2's presentation-rate bridge.
+ * The legacy SaltySD endpoint is a one-session service held by SaltyNX Core;
+ * this second endpoint lets the emulator query the rate and map the existing
+ * shared FPSLocker block without competing for that session. */
+void serviceThreadDisplaySync(void* portHandle)
+{
+    const Handle port = (Handle)(uintptr_t)portHandle;
+    while (1) {
+        Handle session;
+        Result ret = svcAcceptSession(&session, port);
+        if (R_FAILED(ret)) {
+            svcSleepThread(1000 * 1000);
+            continue;
+        }
+
+        Handle replySession = 0;
+        while (1) {
+            int handleIndex;
+            ret = svcReplyAndReceive(&handleIndex, &session, 1, replySession, UINT64_MAX);
+            if (R_FAILED(ret))
+                break;
+
+            IpcParsedCommand request = {0};
+            ipcParse(&request);
+            struct {
+                u64 magic;
+                u64 command;
+                u64 reserved[2];
+            } *raw = request.Raw;
+
+            if (raw->command == handleService_GetDisplayRefreshRate) {
+                handleServiceCmd((int)raw->command);
+            } else if (raw->command == handleService_GetSharedMemoryHandle) {
+                IpcCommand response;
+                ipcInitialize(&response);
+                ipcSendHandleCopy(&response, _sharedMemory.handle);
+                struct {
+                    u64 magic;
+                    u64 result;
+                } *out = ipcPrepareHeader(&response, sizeof(*out));
+                out->magic = SFCO_MAGIC;
+                out->result = 0;
+            } else {
+                IpcCommand response;
+                ipcInitialize(&response);
+                struct {
+                    u64 magic;
+                    u64 result;
+                } *out = ipcPrepareHeader(&response, sizeof(*out));
+                out->magic = SFCO_MAGIC;
+                out->result = 0xEE01;
+            }
+            replySession = session;
+        }
+        svcCloseHandle(session);
+    }
+}
